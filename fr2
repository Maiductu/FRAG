-- 10. COMBAT FRAMEWORK & MULTI-HITBOX BATCH FAST ATTACK
-- --------------------------------------------------------------------------------
local LastBatchAttack = 0

function Core.BatchFastAttack(monName: string, centerPos: Vector3, radius: number)
    local now = os.clock()
    if now - LastBatchAttack < 0.05 then return end
    LastBatchAttack = now

    pcall(function()
        local targets = {}
        local enemies = Workspace:FindFirstChild("Enemies")
        if not enemies then return end

        local primaryHead = nil

        for _, v in ipairs(enemies:GetChildren()) do
            local hum = v:FindFirstChildOfClass("Humanoid")
            local root = v:FindFirstChild("HumanoidRootPart")
            local head = v:FindFirstChild("Head") or root
            if v.Name == monName and hum and root and hum.Health > 0 then
                if (root.Position - centerPos).Magnitude <= radius then
                    table.insert(targets, { [1] = v, [2] = root })
                    if not primaryHead and head then
                        primaryHead = head
                    end
                end
            end
        end

        -- 1. Blox Fruits CombatFramework Integration
        pcall(function()
            local cfModule = ReplicatedStorage:FindFirstChild("CombatFramework")
            if cfModule then
                local CombatFramework = require(cfModule)
                local ac = CombatFramework.activeController
                if ac and ac.equipped then
                    ac.hitboxMagnitude = 55
                    if ac.attack then
                        ac:attack()
                    end
                end
            end
        end)

        -- 2. Net Remote Multi-Hitbox RegisterHit
        if #targets > 0 and primaryHead then
            local net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
            local registerAttack = net and net:FindFirstChild("RegisterAttack")
            local registerHit = net and net:FindFirstChild("RegisterHit")

            if registerAttack then registerAttack:FireServer(0) end
            if registerHit then
                local fakeHash = tostring(LocalPlayer.UserId):sub(2, 4) .. tostring(math.random(10000, 99999))
                registerHit:FireServer(primaryHead, targets, {}, fakeHash)
            end
        end

        -- Fallback Tool Activation (Auto-Attack: Melee priority, fallback ANY tool if no melee owned)
        local char = LocalPlayer.Character
        if char and char:FindFirstChildOfClass("Tool") then
            local tool = char:FindFirstChildOfClass("Tool")
            local isMelee = tool.ToolTip == "Melee" or tool:FindFirstChild("Melee") or MeleeAliasMap[tool.Name]
            -- If it's a melee, OR the player owns no melee at all -> attack with whatever is equipped
            if isMelee or (not Core.HasAnyMelee()) then
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                tool:Activate()
            end
        end
    end)
end

local FastAttackRunning = false

function Core.StartFastAttack()
    if FastAttackRunning then return end
    FastAttackRunning = true

    task.spawn(function()
        while FastAttackRunning do
            task.wait(0.05)
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChildOfClass("Tool") then
                    local tool = char:FindFirstChildOfClass("Tool")
                    local isMelee = tool.ToolTip == "Melee" or tool:FindFirstChild("Melee") or MeleeAliasMap[tool.Name]
                    if isMelee or (not Core.HasAnyMelee()) then
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                        tool:Activate()
                    end
                end
            end)
        end
    end)
end

function Core.StopFastAttack()
    FastAttackRunning = false
end

