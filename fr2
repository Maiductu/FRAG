local CachedWeapons = {}
local LastWeaponsCheck = 0

function Core.GetMeleeMastery(meleeName: string): number
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local canonicalName = MeleeAliasMap[meleeName] or meleeName

    -- 1. Check direct Tool Level Value in Character/Backpack
    for _, container in ipairs({ char, backpack }) do
        if container then
            for _, tool in ipairs(container:GetChildren()) do
                if tool:IsA("Tool") and (tool.Name == canonicalName or MeleeAliasMap[tool.Name] == canonicalName) then
                    local lvlObj = tool:FindFirstChild("Level") or tool:FindFirstChild("Mastery") or tool:FindFirstChild("MasteryLevel")
                    if lvlObj and lvlObj:IsA("IntValue") then
                        return lvlObj.Value
                    end
                end
            end
        end
    end

    -- 2. Query Game Remote Inventory
    local now = os.clock()
    if now - LastWeaponsCheck > 15 then
        pcall(function()
            local comm = GetCommF()
            if comm then
                local inv = comm:InvokeServer("getInventoryWeapons")
                if type(inv) == "table" then
                    CachedWeapons = inv
                end
            end
        end)
        LastWeaponsCheck = now
    end

    for _, item in pairs(CachedWeapons) do
        local itemName = item.Name or ""
        if itemName == canonicalName or MeleeAliasMap[itemName] == canonicalName then
            return item.Mastery or item.Level or item.MasteryLevel or 0
        end
    end

    return 0
end

function Core.HasMelee(meleeName: string): boolean
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local canonicalName = MeleeAliasMap[meleeName] or meleeName

    if char and (char:FindFirstChild(canonicalName) or (char:FindFirstChild(meleeName))) then return true end
    if backpack and (backpack:FindFirstChild(canonicalName) or (backpack:FindFirstChild(meleeName))) then return true end

    for _, item in pairs(CachedWeapons) do
        local itemName = item.Name or ""
        if itemName == canonicalName or MeleeAliasMap[itemName] == canonicalName then
            return true
        end
    end
    return false
end

