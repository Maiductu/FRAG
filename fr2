function Core.UnlockElectricClaw(KaitunData)
    pcall(function()
        local comm = GetCommF()
        if not comm or Core.CheckInventory("Electric Claw") then return end
        if Core.GetMeleeMastery("Electric") < 400 then return end

        local beli = Core.GetBeli()
