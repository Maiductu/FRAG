function KaitunData.GetQuestForLevel(level: number, sea: number)
    local questList = KaitunData.Sea1Quests
    if sea == 2 then questList = KaitunData.Sea2Quests
    elseif sea == 3 then questList = KaitunData.Sea3Quests
    end

    local bestQuest = nil
    for _, q in ipairs(questList) do
        if level >= q.MinLevel and level <= q.MaxLevel then
            return q
        end
        if level >= q.MinLevel then
            bestQuest = q
        end
    end
    return bestQuest or questList[#questList]
end

function KaitunData.GetBossForLevel(level: number, sea: number)
    local bossList = KaitunData.Sea1Bosses
    if sea == 2 then bossList = KaitunData.Sea2Bosses
    elseif sea == 3 then return nil
    end

    local availableBosses = {}
    for _, b in ipairs(bossList) do
        if level >= b.MinLevel then
            table.insert(availableBosses, b)
        end
    end

    if #availableBosses > 0 then
        return availableBosses[#availableBosses]
    end
    return nil
end

