function Core.IsExpBoostActive(): boolean
    local mainGui = LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("Main")
    if not mainGui then return false end

    local expBoost = mainGui:FindFirstChild("ExpBoost") or mainGui:FindFirstChild("Boost")
    if expBoost and expBoost.Visible then return true end

    local bottomHUD = mainGui:FindFirstChild("BottomHUDList")
    if bottomHUD and bottomHUD:FindFirstChild("2xExp") and bottomHUD["2xExp"].Visible then
        return true
    end

    return false
end

function Core.CheckAndRedeemNextCode()
    pcall(function()
        if Core.IsExpBoostActive() then return end

        local idx = GlobalEnv.CurrentCodeIndex or 1
        if idx > #PromoCodes then
            -- Restart loop so new codes added on future updates get picked up
            GlobalEnv.CurrentCodeIndex = 1
            return
        end

        local code = PromoCodes[idx]
        local comm = GetCommF()
        if comm then
