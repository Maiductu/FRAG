        -- 1. Talk to Previous Hero
        Core.TweenTo(KaitunData.Sea3Locations.PreviousHero)
        comm:InvokeServer("BuyElectricClaw", "Start")
        task.wait(0.5)

        -- 2. Fast Tween to Mansion within 30s limit (takes ~5s)
        Core.TweenTo(KaitunData.Sea3Locations.TurtleMansionDoor)
        task.wait(1)

        -- 3. Return to Previous Hero & Purchase Electric Claw
        Core.TweenTo(KaitunData.Sea3Locations.PreviousHero)
        task.wait(0.5)
        comm:InvokeServer("BuyElectricClaw", "Buy")
    end)
end

local LastDeathKingRoll = 0

function Core.RollFireEssence(KaitunData)
    pcall(function()
        local comm = GetCommF()
        if not comm or Core.CheckInventory("Dragon Talon") then return end

        -- 1. If we already have Fire Essence, buy Dragon Talon at Uzoth
        if Core.CheckInventory("Fire Essence") and Core.GetMeleeMastery("Dragon Breath") >= 400 then
            local beli = Core.GetBeli()
            local frags = Core.GetFragments()
            if beli >= 3000000 and frags >= 5000 then
                Core.TweenTo(KaitunData.Sea3Locations.Uzoth)
                comm:InvokeServer("BuyDragonTalon")
            end
            return
        end

        -- 2. Check 2-hour cooldown timer & Bones count
        local now = os.clock()
        if now - LastDeathKingRoll < 7200 then return end

        local bones = Core.GetMaterialCount("Bones")
        if bones >= 50 then
            Core.TweenTo(KaitunData.Sea3Locations.DeathKing)
            local rollCount = math.clamp(math.floor(bones / 50), 1, 10)
            for _ = 1, rollCount do
                local res = comm:InvokeServer("Bones", "Buy", 1, 1)
                task.wait(0.3)
                if res == "Fire Essence" or Core.CheckInventory("Fire Essence") then
                    break
                end
            end
            LastDeathKingRoll = now
        end
    end)
end

