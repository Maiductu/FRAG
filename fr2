function Core.EquipWeapon(weaponName: string)
    pcall(function()
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        local char = LocalPlayer.Character
        if not backpack or not char or not char:FindFirstChild("Humanoid") then return end

        local tool = backpack:FindFirstChild(weaponName)
        if tool and tool:IsA("Tool") then
            char.Humanoid:EquipTool(tool)
        end
    end)
end

local LastMeleeEquipAttempt = 0

function Core.EquipBestWeapon()
    pcall(function()
        local targetMelee = Core.GetNextMeleeToMaster()
        local char = LocalPlayer.Character
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if not char or not char:FindFirstChild("Humanoid") or not backpack then return end

        local equipped = char:FindFirstChildOfClass("Tool")

        -- If we have no melee to target, keep whatever tool is equipped (safety fallback)
        if not targetMelee then
            if equipped then
                return -- already holding something (e.g. Katana)
            end
            -- equip the first available Tool so the player can attack at all
            for _, t in ipairs(backpack:GetChildren()) do
                if t:IsA("Tool") then
                    char.Humanoid:EquipTool(t)
                    return
                end
            end
            return
        end

        if equipped and (equipped.Name == targetMelee or (equipped.ToolTip == "Melee" and equipped.Name == targetMelee) or MeleeAliasMap[equipped.Name] == targetMelee) then
            return
        end

        local tool = backpack:FindFirstChild(targetMelee)
        if tool and tool:IsA("Tool") then
            char.Humanoid:EquipTool(tool)
        else
            local now = os.clock()
            if now - LastMeleeEquipAttempt > 3 then
                LastMeleeEquipAttempt = now
                local comm = GetCommF()
                if comm and MeleeEquipRemotes[targetMelee] then
                    MeleeEquipRemotes[targetMelee](comm)
                    task.defer(function()
                        task.wait(0.2)
                        local newTool = backpack:FindFirstChild(targetMelee)
                        if newTool and newTool:IsA("Tool") and char and char:FindFirstChild("Humanoid") then
                            char.Humanoid:EquipTool(newTool)
                        end
                    end)
                end
            end
        end
    end)
end

