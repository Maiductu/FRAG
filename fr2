function Core.HopServer()
    pcall(function()
        Core.StopFastAttack()
        Core.StopTween()
        collectgarbage("collect")

        local placeId = game.PlaceId
        local serversUrl = "https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?sortOrder=Asc&limit=100"
