local KaitunBrain = {}

function KaitunBrain.GetCurrentSea(): number
    local id = game.PlaceId
    if id == KaitunData.PlaceIds.Sea1 then return 1
    elseif id == KaitunData.PlaceIds.Sea2 then return 2
    elseif id == KaitunData.PlaceIds.Sea3 then return 3
    end

    -- Dynamic level-based fallback if PlaceId is custom or private server
    local data = LocalPlayer:FindFirstChild("Data")
    local lvl = (data and data:FindFirstChild("Level") and (data.Level :: IntValue).Value) or 1
    if lvl >= 1500 then return 3
    elseif lvl >= 700 then return 2
    else return 1
    end
end

function KaitunBrain.HasQuest(): boolean
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    local q = pg and pg:FindFirstChild("Main") and pg.Main:FindFirstChild("Quest")
    return (q and q.Visible) or false
end

function KaitunBrain.AcceptQuest(questData)
    local comm = GetCommF()
    if comm and questData then
        pcall(function()
            comm:InvokeServer("StartQuest", questData.NameQuest, questData.LevelQuest)
        end)
    end
end

function KaitunBrain.AbandonQuest()
    local comm = GetCommF()
    if comm then
        pcall(function()
            comm:InvokeServer("AbandonQuest")
        end)
    end
end

function KaitunBrain.CheckAutoPurchases(level: number, sea: number)
    pcall(function()
        local beli = Core.GetBeli and Core.GetBeli() or 0
        local buyHaki = Config["Buy Haki"] or {}

        if sea == 1 then
            if level >= 50 then
                if buyHaki["Skyjump"] and beli >= 10000 and Core.CheckInventory and not Core.CheckInventory("AirJump") then
                    if Core.BuyAbility then Core.BuyAbility("Geppo") end
                end
                if buyHaki["Enhancement"] and beli >= 25000 and Core.CheckInventory and not Core.CheckInventory("Buso") then
                    if Core.BuyAbility then Core.BuyAbility("Buso") end
                end
            end

            if level >= 375 and beli >= 750000 and Core.CheckInventory and not Core.CheckInventory("Water Kung Fu") then
                if Core.BuyMelee and KaitunData.WaterKungFuTeacher then
                    Core.BuyMelee(KaitunData.WaterKungFuTeacher.Remote)
                end
            end
        elseif sea == 2 then
            if Core.AutoBuySea2Melees then
                Core.AutoBuySea2Melees(level)
            end
        elseif sea == 3 then
            if Core.AutoBuySea3Melees then
                Core.AutoBuySea3Melees(level, KaitunData, Config)
            end
        end
    end)
end

function KaitunBrain.Run()
    -- 1. Auto Reconnect & Error Catcher
    if Config["Auto Reconnect"] and Core.SetupAutoReconnect then
        Core.SetupAutoReconnect()
    end

    -- 2. Engine 3D Rendering & FPS Cap
    if Config["Disable 3D Rendering"] and Core.Disable3DRendering then
        Core.Disable3DRendering(Config["FPS Cap"] or 15)
    elseif Config["Boost FPS"] and Core.BoostFPS then
        Core.BoostFPS()
    end

    -- 3. Memory Garbage Collector (Every 300s)
    task.spawn(function()
        while task.wait(300) do
            collectgarbage("collect")
        end
    end)

    -- 4. Watchdog Thread (Chống Treo Vô Hình / Ghost-State > 500s)
    if Config["Enable Watchdog"] then
        task.spawn(function()
            local lastExp = 0
            local lastLevel = 0
            local lastChangeTime = os.clock()

            while task.wait(10) do
                local data = LocalPlayer:FindFirstChild("Data")
                local exp = (data and data:FindFirstChild("Exp") and (data.Exp :: IntValue).Value) or 0
                local lvl = (data and data:FindFirstChild("Level") and (data.Level :: IntValue).Value) or 0

                if exp ~= lastExp or lvl ~= lastLevel then
                    lastExp = exp
                    lastLevel = lvl
                    lastChangeTime = os.clock()
                else
                    if os.clock() - lastChangeTime > 500 then
                        print("[Watchdog Warning] Ghost-State Detected (No EXP/Level gain for 500s)! Hopping server...")
                        if Core.HopServer then Core.HopServer() end
                        break
                    end
                end
            end
        end)
    end

    LocalPlayer.CharacterAdded:Connect(function()
        if Core.StopTween then Core.StopTween() end
    end)

    task.spawn(function()
        for _ = 1, 5 do
            if Core.SelectTeam then
                Core.SelectTeam("Pirates")
            end
            task.wait(0.5)
        end
    end)

    if Config["Auto Redeem Codes"] then
        task.spawn(function()
            while task.wait(30) do
                if Core.CheckAndRedeemNextCode then
                    Core.CheckAndRedeemNextCode()
                end
            end
        end)
    end

    if Config["Sniper Fruits"] and #Config["Sniper Fruits"] > 0 then
        task.spawn(function()
            while task.wait(10) do
                if Core.SnipeFruits then
                    Core.SnipeFruits(Config["Sniper Fruits"])
                end
            end
        end)
    end

    task.spawn(function()
        local lastTickStat = 0
        local lastTickCheck = 0
        local activeQuestData = nil
        local questStartTime = 0

        print("[Kaitun Brain] 100% Production Engine Active! Sea 1, 2, 3 Speedrun (Godhuman & Level 2800)")

        while task.wait(0.1) do
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local data = LocalPlayer:FindFirstChild("Data")

            if not root or not hum or hum.Health <= 0 or not data or not data:FindFirstChild("Level") then
                task.wait(0.5)
                continue
            end

            local level = data.Level.Value
            local sea = KaitunBrain.GetCurrentSea()

            -- [HIGH PRIORITY INTERRUPT] Handle Boss Keys (Library Key & Water Key) in Sea 2
            if sea == 2 and Core.HandleBossKeys and Core.HandleBossKeys(KaitunData) then
                task.wait(0.5)
                continue
            end

            local now = os.clock()
            if now - lastTickStat > 3 then
                if Config["Auto Allocate Stats"] ~= false and Core.AutoAllocateStats then
                    Core.AutoAllocateStats(level, Config)
                end
                if Config["Auto Buso Haki"] ~= false and Core.AutoBusoHaki then
                    Core.AutoBusoHaki()
                end
                lastTickStat = now
            end

            if now - lastTickCheck > 10 then
                KaitunBrain.CheckAutoPurchases(level, sea)
                lastTickCheck = now
            end

            -- 1. Sea 1 -> Sea 2 Entrance (Level 700)
            if Config["Auto Sea 2"] and level >= 700 and sea == 1 then
                if Core.RunSea2Entrance then
                    Core.RunSea2Entrance(KaitunData)
                end
                continue
            end

            -- 2. Sea 2 -> Sea 3 Transition (Level 1500: Trevor -> Don Swan -> Rip Indra)
            if Config["Auto Sea 3"] and level >= 1500 and sea == 2 then
                if Core.RunSea3Transition then
                    Core.RunSea3Transition(KaitunData)
                end
                continue
            end

            -- 3. Level 850+ Bartilo Quest (Mandatory Sea 3 Server Flag)
            if sea == 2 and level >= 850 then
                local comm = GetCommF()
                local bartiloProgress = comm and comm:InvokeServer("BartiloQuestProgress", "Bartilo")
                if bartiloProgress ~= 3 then
                    if Core.RunBartiloQuest then
                        Core.RunBartiloQuest(KaitunData)
                    end
                    continue
                end
            end

            -- 4. Level 1100 Solo Flame Raid for Fragments (~12,000 Frags via Trash Fruit)
            if sea == 2 and level >= 1100 and Core.GetFragments and Core.GetFragments() < 12000 and (Config["Auto Raid Flame"] ~= false) then
                if Core.RunFlameRaid then
                    Core.RunFlameRaid()
                end
                continue
            end

            -- 5. Main Level & Mastery Grinding Loop
            if not KaitunBrain.HasQuest() then
                activeQuestData = nil
                questStartTime = 0

                -- Boss Priority Check
                if Config["Auto Boss Priority"] then
                    if sea == 2 then
                        if level >= 1400 and Core.HasMelee and not Core.HasMelee("Death Step") and Core.CheckInventory and not Core.CheckInventory("Library Key") and Core.IsBossAlive and Core.IsBossAlive("Awakened Ice Admiral") then
                            activeQuestData = { MinLevel = 1400, Mon = "Awakened Ice Admiral", LevelQuest = 3, NameQuest = "FrostQuest", NameMon = "Awakened Ice Admiral", CFrameQuest = CFrame.new(5667.6582, 26.7997818, -6486.08984), CFrameMon = CFrame.new(6475.2014, 298.50125, -6840.1025) }
                        elseif level >= 1475 and Core.HasMelee and not Core.HasMelee("Sharkman Karate") and Core.CheckInventory and not Core.CheckInventory("Water Key") and Core.IsBossAlive and Core.IsBossAlive("Tide Keeper") then
                            activeQuestData = { MinLevel = 1475, Mon = "Tide Keeper", LevelQuest = 3, NameQuest = "ForgottenQuest", NameMon = "Tide Keeper", CFrameQuest = CFrame.new(-3054.44458, 235.544281, -10142.8193), CFrameMon = CFrame.new(-3795.1025, 105.2014, -11475.1025) }
                        end
                    end

                    if not activeQuestData and KaitunData.GetBossForLevel then
                        local bossData = KaitunData.GetBossForLevel(level, sea)
                        if bossData and Core.IsBossAlive and Core.IsBossAlive(bossData.Mon) then
                            activeQuestData = bossData
                        end
                    end
                end

                if not activeQuestData and KaitunData.GetQuestForLevel then
                    activeQuestData = KaitunData.GetQuestForLevel(level, sea)
                end

                if activeQuestData then
                    -- Sub-Dimension Entrance Teleport Check
                    if activeQuestData.Entrance and (activeQuestData.CFrameQuest.Position - root.Position).Magnitude > 5000 then
                        local comm = GetCommF()
                        if comm then
                            comm:InvokeServer("requestEntrance", activeQuestData.Entrance)
                            task.wait(0.8)
                        end
                    end

                    if Core.TweenTo then Core.TweenTo(activeQuestData.CFrameQuest) end
                    if (activeQuestData.CFrameQuest.Position - root.Position).Magnitude < 15 then
                        KaitunBrain.AcceptQuest(activeQuestData)
                        questStartTime = os.clock()
                        task.wait(0.3)
                    end
                end
            else
                -- Anti-Stuck Timeout Safeguard (120s)
                if questStartTime > 0 and (os.clock() - questStartTime > 120) then
                    KaitunBrain.AbandonQuest()
                    activeQuestData = nil
                    questStartTime = 0
                    task.wait(0.5)
                    continue
                end

                if activeQuestData then
                    if Core.EquipBestWeapon then Core.EquipBestWeapon() end

                    if activeQuestData.Entrance and (activeQuestData.CFrameMon.Position - root.Position).Magnitude > 5000 then
                        local comm = GetCommF()
                        if comm then
                            comm:InvokeServer("requestEntrance", activeQuestData.Entrance)
                            task.wait(0.8)
                        end
                    end

                    local hoverY = Config["Farm Distance Y"] or 14
                    local targetCombatCFrame = activeQuestData.CFrameMon * CFrame.new(0, hoverY, 0)

                    -- Lock Position on-air (No Rubberbanding)
                    if Core.LockCombatPosition then Core.LockCombatPosition(targetCombatCFrame) end

                    -- Multi-Hitbox Batch Fast Attack
                    local radius = Config["Batch Attack Radius"] or 300
                    if Core.BatchFastAttack then
                        Core.BatchFastAttack(activeQuestData.NameMon, activeQuestData.CFrameMon.Position, radius)
                    end

                    if Config["Bring Mob"] and Core.BringMobs then
                        Core.BringMobs(activeQuestData.NameMon, activeQuestData.CFrameMon.Position, radius)
                    end
                else
                    if KaitunData.GetQuestForLevel then
                        activeQuestData = KaitunData.GetQuestForLevel(level, sea)
                    end
                end
            end
        end
    end)
end

KaitunBrain.Run()
return KaitunBrain
