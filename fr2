function Core.AutoAllocateStats(currentLevel: number, configTable: table?)
    pcall(function()
        if not LocalPlayer:FindFirstChild("Data") or not LocalPlayer.Data:FindFirstChild("Points") then return end
        local points = LocalPlayer.Data.Points.Value
        if points <= 0 then return end

        local comm = GetCommF()
        if not comm then return end

        local statPriority = (configTable and (configTable["Stat Priority"] or configTable.StatPriority))
        local meleeRatio = 0.70
        local defenseRatio = 0.30

        if currentLevel <= 50 then
            meleeRatio = 1.0
            defenseRatio = 0.0
            if statPriority and statPriority["Level 1-50"] then
                local m = statPriority["Level 1-50"].Melee or 100
                local d = statPriority["Level 1-50"].Defense or 0
                meleeRatio = m / (m + d)
                defenseRatio = d / (m + d)
            end
        else
            if statPriority and statPriority["Level 50+"] then
                local m = statPriority["Level 50+"].Melee or 70
                local d = statPriority["Level 50+"].Defense or 30
                meleeRatio = m / (m + d)
                defenseRatio = d / (m + d)
            end
        end

        local addMelee = math.floor(points * meleeRatio)
        local addDefense = points - addMelee

        if addMelee > 0 then comm:InvokeServer("AddPoint", "Melee", addMelee) end
        if addDefense > 0 then comm:InvokeServer("AddPoint", "Defense", addDefense) end
    end)
end

