function Core.RunBartiloQuest(KaitunData)
    pcall(function()
        local comm = GetCommF()
        if not comm then return end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local progress = comm:InvokeServer("BartiloQuestProgress", "Bartilo")
        if progress == 3 then return end

        if progress == 0 or progress == nil then
            local pg = LocalPlayer:FindFirstChild("PlayerGui")
            local questGui = pg and pg:FindFirstChild("Main") and pg.Main:FindFirstChild("Quest")
            local questTitle = questGui and questGui.Visible and questGui:FindFirstChild("Container") and questGui.Container:FindFirstChild("QuestTitle") and questGui.Container.QuestTitle:FindFirstChild("Title")

            if questTitle and string.find(questTitle.Text, "Swan Pirate") then
                local enemies = Workspace:FindFirstChild("Enemies")
                local swanMob = enemies and enemies:FindFirstChild("Swan Pirate")
                if swanMob and swanMob:FindFirstChild("HumanoidRootPart") and swanMob:FindFirstChild("Humanoid") and swanMob.Humanoid.Health > 0 then
                    Core.TweenTo(swanMob.HumanoidRootPart.CFrame * CFrame.new(0, 14, 0))
                    Core.EquipBestWeapon()
                    Core.StartFastAttack()
                    Core.BringMobs("Swan Pirate", swanMob.HumanoidRootPart.Position, 300)
                else
                    Core.TweenTo(KaitunData.BartiloQuest.SwanPirateFarm)
                end
            else
                Core.TweenTo(KaitunData.BartiloQuest.BartiloNPC)
                if (KaitunData.BartiloQuest.BartiloNPC.Position - hrp.Position).Magnitude < 15 then
                    comm:InvokeServer("BartiloQuestProgress", "Bartilo")
                    comm:InvokeServer("StartQuest", "Area2Quest", 1)
                    task.wait(0.5)
                end
            end
        elseif progress == 1 then
            local enemies = Workspace:FindFirstChild("Enemies")
            local jeremy = enemies and enemies:FindFirstChild("Jeremy")
            if jeremy and jeremy:FindFirstChild("HumanoidRootPart") and jeremy:FindFirstChild("Humanoid") and jeremy.Humanoid.Health > 0 then
                Core.TweenTo(jeremy.HumanoidRootPart.CFrame * CFrame.new(0, 14, 0))
                Core.EquipBestWeapon()
                Core.StartFastAttack()
            else
                Core.TweenTo(KaitunData.BartiloQuest.JeremySpawn)
            end
        elseif progress == 2 then
            Core.TweenTo(KaitunData.BartiloQuest.BartiloNPC)
            if (KaitunData.BartiloQuest.BartiloNPC.Position - hrp.Position).Magnitude < 15 then
                comm:InvokeServer("BartiloQuestProgress", "Bartilo")
                task.wait(0.3)
            end

            for _, btnCFrame in ipairs(KaitunData.BartiloQuest.ColosseumButtons) do
                hrp.CFrame = btnCFrame
                task.wait(0.2)
            end
            task.wait(0.5)
        end
    end)
end

