local LastSnipeCheck = 0

function Core.SnipeFruits(fruitList: { string })
    local now = os.clock()
    if now - LastSnipeCheck < 60 then return end
    LastSnipeCheck = now

    pcall(function()
        local comm = GetCommF()
        if not comm then return end

        local char = LocalPlayer.Character
        local backpack = LocalPlayer:FindFirstChild("Backpack")

        -- 1. Scan owned fruits in storage, backpack, and character
        local stored = comm:InvokeServer("getInventoryFruits")
        local ownedFruits = {}
        if type(stored) == "table" then
            for _, item in pairs(stored) do
                if item.Name then
                    ownedFruits[item.Name] = true
                end
            end
        end

        if backpack then
            for _, tool in ipairs(backpack:GetChildren()) do
                if tool:IsA("Tool") then ownedFruits[tool.Name] = true end
            end
        end
        if char then
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") then ownedFruits[tool.Name] = true end
            end
        end

        -- 2. Gacha roll from Cousin if Beli >= $500,000
        if Core.GetBeli() >= 500000 then
            comm:InvokeServer("Cousin", "Buy")
            task.wait(0.3)
        end

        -- 3. Stock Purchase from Fruit Dealer strictly for unowned fruits
        comm:InvokeServer("GetFruits")
        for _, fruitName in ipairs(fruitList) do
            if not ownedFruits[fruitName] then
                comm:InvokeServer("PurchaseRawFruit", fruitName)
                task.wait(0.2)
            end
        end
    end)
end

